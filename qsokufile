# Entry points for building and checking this project (.claude/rules/testing.md).
# qsoku always runs these with sh, so every entry works the same no matter which
# shell called it.

build: (cd //; go build ./...)

# Rewrite files with the formatters enabled in .golangci.yaml.
fmt: (cd //; golangci-lint fmt)

vet: (cd //; go vet ./...)

# Also reports files that the formatters would change. If golangci-lint is older
# than the Go in this container it cannot read the standard library (typecheck
# errors "export data version N is greater than ..."); say what to do about it.
lint: (cd //; if out=$(golangci-lint run 2>&1); then printf '%s\n' "$out"; else printf '%s\n' "$out"; if printf '%s' "$out" | grep -q 'export data version'; then echo "hint: this golangci-lint is older than the Go in this container and cannot read its standard library. Update it: go install github.com/golangci/golangci-lint/v2/cmd/golangci-lint@latest (.claude/rules/testing.md)" >&2; fi; false; fi)

unit: (cd //; go test ./...)

# Type-check and lint for the other OSes. Process and signal handling is split
# by build tags, and a Linux-only run would not notice a broken Windows file.
cross: (cd //; rc=0; for os in windows darwin; do echo "== GOOS=$os"; GOOS=$os go vet ./... && GOOS=$os golangci-lint run || rc=1; done; [ "$rc" -eq 0 ])

check: qsoku vet && qsoku lint && qsoku unit && qsoku cross

# Build the bcuz binary into bin/ to try it by hand.
bin: (cd //; go build -o bin/bcuz ./cmd/bcuz)

# Open a shell in a temporary workspace with bin/bcuz on PATH, to try Ctrl-C,
# colors and a full-screen editor by hand (dev/try.sh, dev/roadmap.md).
try: qsoku bin && (cd //; bash dev/try.sh)

# -race needs cgo, which the container turns off (.devcontainer/devcontainer.json).
race: (cd //; CGO_ENABLED=1 go test -race -count=1 ./...)

trivy: (cd //; trivy fs --config trivy.yaml .)

shellcheck: (cd //; git ls-files '*.sh' '*.bash' | xargs -r shellcheck)

# go install into a temporary directory and use it (dev/install-check.sh).
# Without an argument it installs this checkout; with v0.1.0 or latest, the
# published module.
install-check: (cd //; bash dev/install-check.sh "$@")

# Build the six binaries and SHA256SUMS into dist/ (dev/dist.sh). Set VERSION
# for a release build: VERSION=v0.1.0 qsoku dist.
dist: (cd //; bash dev/dist.sh)
